#compdef with-secrets ws
# Tab-completion for with-secrets/ws: only completes external commands on
# PATH that have a matching ~/env/<name>.env, since those are the ones
# with-secrets is useful for.

local -a cmds c
for c in ${(k)commands}; do
  [[ -f "$HOME/env/$c.env" ]] && cmds+=("$c:")
done

_describe -t commands 'command with secrets' cmds
