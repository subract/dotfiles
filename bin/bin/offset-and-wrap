#!/usr/bin/env python3
"""
tile_offset.py - prepares an image for smoother tiling
expands canvas 2x, tiles image in corner while keeping image centered

Usage: python3 tile_offset.py path/to/image.png
"""

import sys
from pathlib import Path
import numpy as np
from PIL import Image, ImageChops

def offset_and_combine(image_path: Path) -> Path:
  img = Image.open(image_path).convert("RGB")
  w, h = img.size
  canvas_w, canvas_h = w * 2, h * 2

  # Expand canvas 2x, with image in center
  base = Image.new("RGB", (canvas_w, canvas_h), (255, 255, 255))
  base.paste(img, (w // 2, h // 2))

  arr = np.array(base)
  shifted = np.roll(arr, shift=canvas_h // 2, axis=0)
  shifted = np.roll(shifted, shift=canvas_w // 2, axis=1)
  shifted_img = Image.fromarray(shifted)

  combined = ImageChops.darker(base, shifted_img)

  output_path = image_path.with_name(f"{image_path.stem}_offset{image_path.suffix}")
  combined.save(output_path)
  return output_path

def main():
  if len(sys.argv) != 2:
    print(f"Usage: {sys.argv[0]} <path-to-image>")
    sys.exit(1)

  image_path = Path(sys.argv[1])
  if not image_path.is_file():
    print(f"Error: file not found: {image_path}")
    sys.exit(1)

  output_path = offset_and_combine(image_path)

  if output_path.is_file():
    print(f"Offset+combined tile saved to: {output_path}")
  else:
    print("Error: output file was not created.")
    sys.exit(1)

if __name__ == "__main__":
  main()
