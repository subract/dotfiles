#!/usr/bin/env zsh
# ws <name> [args...] — run the named command (via PATH) with env/common.env
# plus env/<name>.env (sops-encrypted or plain) in its environment.
# ws — fzf multiselect over env/*.env (minus common), then an interactive
# subshell with common + selected secrets. Parent shell never sees secrets.
# $HOME/env holds common.env and <name>.env files (sops-encrypted or plain).
set -euo pipefail
envdir="$HOME/env"

load-env() {
  local f="$1" quiet="${2:-}" line
  local -a lines
  if grep -q '^sops_mac=ENC\[' "$f" 2>/dev/null; then
    [[ -t 1 ]] && printf '🤏'
    lines=("${(f)$(sops -d "$f")}")
    [[ -t 1 ]] && printf '\r\e[K'
  else
    [[ "$quiet" == quiet ]] || echo "ws: warning: $f is not sops-encrypted — loading as plaintext" >&2
    lines=("${(f)$(<"$f")}")
  fi
  for line in "${lines[@]}"; do
    [[ -z "$line" || "$line" == \#* || "$line" == sops_* || "$line" != *=* ]] && continue
    export "$line"
  done
}

# named invocation: run the command with common + its own env
if (( $# )); then
  local name="$1"
  shift
  load-env "$envdir/common.env" quiet
  [[ -f "$envdir/$name.env" ]] && load-env "$envdir/$name.env" || echo "ws: no env/$name.env — using common only" >&2
  command -v "$name" >/dev/null 2>&1 || { echo "ws: command not found: $name" >&2; exit 1; }
  exec "$name" "$@"
fi

# bare invocation: fzf multiselect, then interactive subshell
local -a files names selected
files=("$envdir"/*.env(N))
for f in "${files[@]}"; do
  [[ "${f:t}" == common.env ]] && continue
  names+=("${f:t:r}")
done
load-env "$envdir/common.env" quiet
selected=()
if (( ${#names} )); then
  local preview='f="'"$envdir"'/{}.env"; if grep -q "^sops_mac=ENC\[" "$f" 2>/dev/null; then sops -d "$f" 2>/dev/null; else cat "$f" 2>/dev/null; fi | sed -E
"s/=.*/=········/; /^sops_/d"'
  local fzf_out
  fzf_out=$(printf '%s\n' "${names[@]}" | fzf -m --header 'Tab to select secret sets (common.env always loaded), Esc for none' --preview "$preview"
--preview-window right:50% 2>/dev/null || true)
  selected=("${(f)fzf_out}")
fi
local name
for name in "${selected[@]}"; do
  if [[ -f "$envdir/$name.env" ]]; then
    load-env "$envdir/$name.env"
  fi
done
echo "ws: exit to drop the secrets"
local secrets_status=0
"${SHELL:-/bin/zsh}" -i || secrets_status=$?
echo "ws: secrets shell exited — secret variables are gone from this session"
exit $secrets_status
