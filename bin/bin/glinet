#!/usr/bin/env bash
set -e
set -u
set -o pipefail

SSH_TARGET="root@${ROUTER_IP}"

usage() {
    cat <<EOF
usage: glinet <subcommand> [args]

Router: ${ROUTER_IP} (override with \$ROUTER_IP)

subcommands:
  static add <MAC|IP> <IP>  Create a static DHCP lease; first arg may be a MAC
                            or an IP that already has a lease (MAC is looked up)
  static list               Show static leases (🟢 = in use, ⚪ = no active lease)
  help                      Show this help
EOF
}

die() {
    echo "glinet: $*" >&2
    exit 1
}

valid_mac() {
    [[ "$1" =~ ^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$ ]]
}

valid_ip() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

# Print the MAC for a given argument: MACs pass through, IPs are resolved
# against active dnsmasq leases and existing static entries on the router.
resolve_mac() {
    local arg="$1" mac=""

    if valid_mac "$arg"; then
        echo "$arg"
        return
    fi

    # shellcheck disable=SC2016  # expanded on the router
    mac=$(ssh "$SSH_TARGET" "
        mac=\$(awk -v ip='$arg' 'tolower(\$3)==tolower(ip) {print \$2}' /tmp/dhcp.leases 2>/dev/null)
        if [ -z \"\$mac\" ]; then
            mac=\$(uci -q show dhcp | grep '=host' | cut -d. -f2 | cut -d= -f1 | while read -r s; do
                [ \"\$(uci -q get dhcp.\$s.ip)\" = '$arg' ] && uci -q get dhcp.\$s.mac && break
            done)
        fi
        [ -n \"\$mac\" ] && echo \"\$mac\"
        exit 0
    ") || die "couldn't reach router at ${ROUTER_IP}"

    [[ -n "$mac" ]] || die "no lease found for ${arg} on ${ROUTER_IP} (is the client currently connected?)"
    echo "$mac"
}

cmd_static_add() {
    [[ $# -eq 2 ]] || die "static add requires a MAC (or existing IP) and an IP"
    local src="$1" ip="$2" mac

    if ! valid_mac "$src" && ! valid_ip "$src"; then
        die "'$src' is neither a MAC address (AA:BB:CC:DD:EE:FF) nor an IP"
    fi
    valid_ip "$ip" || die "'$ip' doesn't look like an IPv4 address"

    mac=$(resolve_mac "$src")
    mac=$(echo "$mac" | tr 'a-f' 'A-F')

    # Pick up the device's hostname from its current lease, if any
    local hostname=""
    hostname=$(ssh "$SSH_TARGET" "awk -v m='$(echo "$mac" | tr 'A-F' 'a-f')' 'tolower(\$2)==m {print \$4; exit}' /tmp/dhcp.leases 2>/dev/null") || true
    hostname=${hostname//[^a-zA-Z0-9.-]/}
    if [[ -z "$hostname" ]]; then
        hostname="static-$(echo "$mac" | tr -d ':')"
    fi

    if [[ "$src" != "$mac" ]]; then
        echo "Found MAC for ${src}: ${mac}"
    fi
    echo "Creating static lease ${hostname} (${mac}) -> ${ip} on ${ROUTER_IP}..."

    ssh "$SSH_TARGET" "
        set -e
        # Fail if a static lease for a different MAC already claims this IP
        conflict=\$(uci -q show dhcp | grep '=host' | cut -d. -f2 | cut -d= -f1 | while read -r s; do
            [ \"\$(uci -q get dhcp.\$s.ip)\" = '$ip' ] && [ \"\$(uci -q get dhcp.\$s.mac)\" != '$mac' ] && echo \"\$s\" && break
        done || true)
        if [ -n \"\$conflict\" ]; then
            echo \"glinet: a static lease for $ip already exists (mac \$(uci -q get dhcp.\$conflict.mac))\" >&2
            exit 1
        fi

        # Replace an existing lease for this MAC, if any
        existing=\$(uci show dhcp 2>/dev/null | grep \"=host\" | cut -d. -f2 | cut -d= -f1 | while read -r s; do
            [ \"\$(uci -q get dhcp.\$s.mac)\" = '$mac' ] && echo \"\$s\" && break
        done || true)
        if [ -n \"\$existing\" ]; then
            echo 'Removing existing lease for this MAC'
            uci delete dhcp.\$existing
        fi

        lease=\$(uci add dhcp host)
        uci set dhcp.\$lease.name='$hostname'
        uci set dhcp.\$lease.mac='$mac'
        uci set dhcp.\$lease.ip='$ip'
        uci commit dhcp
        /etc/init.d/dnsmasq restart
    "

    echo "Done: ${mac} will always get ${ip}"
}

cmd_static_list() {
    # shellcheck disable=SC2016  # expanded on the router
    local out
    out=$(ssh "$SSH_TARGET" '
        for s in $(uci -q show dhcp | grep "=host" | cut -d. -f2 | cut -d= -f1); do
            printf "%s|%s|%s|%s\n" "$(uci -q get dhcp.$s.mac)" "$(uci -q get dhcp.$s.ip)" "$(uci -q get dhcp.$s.name)" "$(uci -q get dhcp.$s.tag)"
        done
        echo "LEASES"
        awk "{print \$2, \$3}" /tmp/dhcp.leases 2>/dev/null
    ') || die "couldn't reach router at ${ROUTER_IP}"

    local static_lines leases
    static_lines=$(sed -n '1,/^LEASES$/p' <<<"$out" | sed '$d')
    leases=$(sed -n '/^LEASES$/,$p' <<<"$out" | tail -n +2)

    local lines=() icon="" label=""
    while IFS='|' read -r mac ip name tag; do
        [[ -z "$mac" ]] && continue
        label=${name:-$tag}
        if grep -qi "^$mac " <<<"$leases"; then icon="🟢"; else icon="⚪"; fi
        lines+=("$ip|$mac|$label|$icon")
    done <<<"$static_lines"

    if [[ ${#lines[@]} -eq 0 ]]; then
        echo "No static leases configured on ${ROUTER_IP}."
        return
    fi

    # Sort by IP (numeric per octet), then pretty-print
    printf '%s\n' "${lines[@]}" | sort -t'.' -k1,1n -k2,2n -k3,3n -k4,4n |
    awk -F'|' '{ printf "%s  %-18s %-15s %s\n", $4, $2, $1, $3 }'
}

main() {
    [[ $# -lt 1 ]] && { usage; exit 1; }
    local cmd="$1"
    shift

    case "$cmd" in
        static)
            [[ $# -ge 1 ]] || { usage; die "static requires a subcommand (add|list)"; }
            local sub="$1"
            shift
            case "$sub" in
                add)  cmd_static_add "$@" ;;
                list) cmd_static_list ;;
                *) die "unknown static subcommand: $sub (expected add|list)" ;;
            esac
            ;;
        help|-h|--help) usage ;;
        *) usage; die "unknown subcommand: $cmd" ;;
    esac
}

main "$@"
